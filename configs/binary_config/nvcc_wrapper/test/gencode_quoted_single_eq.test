# Bug scenario: -gencode=arch=compute_80,"code=sm_80,compute_80"
# The code part is wrapped in double quotes (single -gencode= form).
# Should produce both vm_10 (compute_80) and ppu_10 (sm_80)
RUN: nvcc --print-hgcc-only '-gencode=arch=compute_80,"code=sm_80,compute_80"' %s
CHECK: #$ hgcc command:
CHECK: -arch=vm_10
CHECK: -arch=ppu_10