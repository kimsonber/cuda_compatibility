{
  "target_exe": "hgcc",
  "options": {
    "--cubin": {
      "short": "-cubin",
      "map_to": "-hgbin"
    },
    "--ptx": {
      "short": "-ptx",
      "map_to": "-hgbin"
    },
    "--cuda": {
      "short": "-cuda",
      "map_to": "-hggc"
    },
    "--extended-lambda": {
      "short": "-extended-lambda",
      "map_to": ["--extended-lambda", "-D__CUDACC_EXTENDED_LAMBDA__"]
    },
    "--expt-extended-lambda": {
      "short": "-expt-extended-lambda",
      "map_to": ["--extended-lambda", "-D__CUDACC_EXTENDED_LAMBDA__"]
    },
    "--device-debug": {
      "short": "-G",
      "map_to": ["-G", "-D__CUDACC_DEBUG__"]
    },
    "--device-w": {
      "short": "-dw",
      "map_to": ["-c", "-rdc=false"]
    },
    "--nvlink-options": {
      "short": "-Xnvlink",
      "map_to": "--hglink-options",
      "needs_value": true,
      "value_map": {
        "-suppress-stack-size-warning": "-ppu-suppress-stack-size-warning",
        "--suppress-stack-size-warning": "-ppu-suppress-stack-size-warning"
      }
    },
    "--fatbin-options": {
      "short": "-Xfatbin",
      "map_to": "--hgfatbinary-options",
      "needs_value": true,
      "value_map": {
        "-cuda": "-hggc",
        "--cuda": "--hggc"
      }
    },
    "--forward-unknown-opts": {
      "short": "-forward-unknown-opts",
      "map_to": ["--forward-unknown-to-host-linker", "--forward-unknown-to-host-compiler"]
    },
    "--link": {
      "short": "-link",
      "needs_ignore": true
    },
    "--suppress-arch-warning": {
      "short": "-suppress-arch-warning",
      "needs_ignore": true
    },
    "--no-display-error-number": {
      "short": "-no-err-no",
      "needs_ignore": true
    },
    "--no-align-double": {
      "needs_ignore": true
    },
    "--source-in-ptx": {
      "short": "-src-in-ptx",
      "needs_ignore": true
    },
    "--extra-device-vectorization": {
      "short": "-extra-device-vectorization",
      "needs_ignore": true
    },
    "--target-directory": {
      "short": "-target-dir",
      "needs_ignore": true,
      "needs_value": true
    },
    "--diag-suppress": {
      "short": "-diag-suppress",
      "needs_ignore": true,
      "needs_value": true
    },
    "--cudafe-options": {
      "short": "-Xcudafe",
      "needs_ignore": true,
      "needs_value": true
    },
    "--compiler-options": {
      "short": "-Xcompiler",
      "map_to": "-Xcompiler",
      "needs_value": true
    },
    "--linker-options": {
      "short": "-Xlinker",
      "map_to": "-Xlinker",
      "needs_value": true
    },
    "--archive-optionss": {
      "short": "-Xarchive",
      "map_to": "-Xarchive",
      "needs_value": true
    },
    "-mllvm": {
      "map_to": "-Xllvm",
      "needs_value": true
    },
    "--objdir-as-tempdir": {
      "short": "-objtemp",
      "needs_ignore": true
    },
    "--Ofast-compil": {
      "short": "-ofc",
      "needs_ignore": true
    },
    "--gen-opt-lto": {
      "short": "-gen-opt-lto",
      "needs_ignore": true
    },
    "--no-host-device-initializer-list": {
      "short": "-nohdinitlist",
      "needs_ignore": true
    },
    "--no-host-device-move-forward": {
      "short": "-nohdmoveforward",
      "needs_ignore": true
    },
    "--device-entity-has-hidden-visibility": {
      "short": "-device-entity-has-hidden-visibility",
      "map_to": "-device-entity-has-hidden-visibility",
      "needs_value": true
    },
    "--dont-use-profile": {
      "short": "-noprof",
      "needs_ignore": true
    },
    "--split-compile": {
      "short": "-split-compile",
      "needs_ignore": true,
      "needs_value": true
    },
    "--split-compile-extended": {
      "short": "-split-compile-extended",
      "needs_ignore": true,
      "needs_value": true
    },
    "--fdevice-syntax-only": {
      "short": "-fdevice-syntax-only",
      "needs_ignore": true
    },
    "--fdevice-time-trace": {
      "short": "-fdevice-time-trace",
      "needs_ignore": true,
      "needs_value": true
    },
    "--time": {
      "short": "-time",
      "needs_ignore": true,
      "needs_value": true
    },
    "--entries": {
      "short": "-e",
      "needs_ignore": true,
      "needs_value": true
    },
    "--Wext-lambda-captures-this": {
      "short": "-Wext-lambda-captures-this",
      "needs_ignore": true
    },
    "--Wno-deprecated-declarations": {
      "short": "-Wno-deprecated-declarations",
      "needs_ignore": true
    },
    "--Wno-deprecated-gpu-targets": {
      "short": "-Wno-deprecated-gpu-targets",
      "needs_ignore": true
    },
    "--extensible-whole-program": {
      "short": "-ewp",
      "needs_ignore": true
    },
    "--display-error-number": {
      "short": "-err-no",
      "needs_ignore": true
    },
    "--diag-error": {
      "short": "-diag-error",
      "needs_ignore": true,
      "needs_value": true
    },
    "--diag-warn": {
      "short": "-diag-warn",
      "needs_ignore": true,
      "needs_value": true
    },
    "--host-linker-script": {
      "short": "-hls",
      "needs_ignore": true,
      "needs_value": true
    },
    "--augment-host-linker-script": {
      "short": "-aug-hls",
      "needs_ignore": true
    },
    "--brief-diagnostic": {
      "short": "-brief-diag",
      "needs_ignore": true,
      "needs_value": true
    },
    "--jump-table-density": {
      "short": "-jtd",
      "needs_ignore": true,
      "needs_value": true
    },
    "--relocatable-ptx": {
      "short": "-reloc-ptx",
      "needs_ignore": true
    },
    "--device-stack-protector": {
      "short": "-device-stack-protector",
      "needs_ignore": true,
      "needs_value": true
    },
    "--frandom-seed": {
      "short": "-frandom-seed",
      "needs_ignore": true,
      "needs_value": true
    },
    "--sanitize": {
      "short": "-sanitize",
      "needs_ignore": true,
      "needs_value": true
    },
    "--jobserver": {
      "short": "-jobserver",
      "needs_ignore": true
    },
    "--allow-unsupported-compiler": {
      "short": "-allow-unsupported-compiler",
      "needs_ignore": true
    },
    "--cudadevrt": {
      "short": "-cudadevrt",
      "needs_value": true,
      "needs_ignore": true
    },
    "--options-file": {
      "short": "-optf",
      "needs_ignore": true
    },
    "--dopt": {
      "short": "-dopt",
      "map_to": "-dopt",
      "needs_value": true,
      "value_map": {
        "off": 0,
        "on": 3
      }
    },
    "--ptxas-options": {
      "short": "-Xptxas",
      "map_to": "--llvm-options",
      "needs_value": true,
      "value_map": {
        "-w": "--no-warn",
        "--disable-warnings": "--no-warn",
        "-warn-spills": "-ppu-warn-spills",
        "--warn-on-spills": "-ppu-warn-spills",
        "--warn-on-double-precision-use": "-ppu-warn-double-usage",
        "-warn-double-usage": "-ppu-warn-double-usage",
        "--warn-on-local-memory-usage": "-ppu-warn-lmem-usage",
        "-warn-lmem-usage": "-ppu-warn-lmem-usage",
        "-suppress-stack-size-warning": "-ppu-suppress-stack-size-warning",
        "--suppress-stack-size-warning": "-ppu-suppress-stack-size-warning",
        "--def-load-cache=ca": "-ppu-dlcm=0",
        "--def-load-cache=cg": "-ppu-dlcm=2",
        "--def-load-cache=cv": "-ppu-dlcm=3",
        "--def-load-cache=cs": "-ppu-dlcm=4",
        "--def-load-cache=lu": "-ppu-dlcm=5",
        "--def-load-cache=wb": "-ppu-dlcm=0",
        "--def-load-cache=wt": "-ppu-dlcm=3",
        "-dlcm=ca": "-ppu-dlcm=0",
        "-dlcm=cg": "-ppu-dlcm=2",
        "-dlcm=cv": "-ppu-dlcm=3",
        "-dlcm=cs": "-ppu-dlcm=4",
        "-dlcm=lu": "-ppu-dlcm=5",
        "-dlcm=wb": "-ppu-dlcm=0",
        "-dlcm=wt": "-ppu-dlcm=3",
        "--def-store-cache=ca": "-ppu-dscm=0",
        "--def-store-cache=cg": "-ppu-dscm=2",
        "--def-store-cache=cv": "-ppu-dscm=3",
        "--def-store-cache=cs": "-ppu-dscm=4",
        "--def-store-cache=lu": "-ppu-dscm=5",
        "--def-store-cache=wb": "-ppu-dscm=0",
        "--def-store-cache=wt": "-ppu-dscm=3",
        "-dscm=ca": "-ppu-dscm=0",
        "-dscm=cg": "-ppu-dscm=2",
        "-dscm=cv": "-ppu-dscm=3",
        "-dscm=cs": "-ppu-dscm=4",
        "-dscm=lu": "-ppu-dscm=5",
        "-dscm=wb": "-ppu-dscm=0",
        "-dscm=wt": "-ppu-dscm=3",
        "--force-load-cache=ca": "-ppu-flcm=0",
        "--force-load-cache=cg": "-ppu-flcm=2",
        "--force-load-cache=cv": "-ppu-flcm=3",
        "--force-load-cache=cs": "-ppu-flcm=4",
        "--force-load-cache=lu": "-ppu-flcm=5",
        "--force-load-cache=wb": "-ppu-flcm=0",
        "--force-load-cache=wt": "-ppu-flcm=3",
        "-flcm=ca": "-ppu-flcm=0",
        "-flcm=cg": "-ppu-flcm=2",
        "-flcm=cv": "-ppu-flcm=3",
        "-flcm=cs": "-ppu-flcm=4",
        "-flcm=lu": "-ppu-flcm=5",
        "-flcm=wb": "-ppu-flcm=0",
        "-flcm=wt": "-ppu-flcm=3",
        "--force-store-cache=ca": "-ppu-fscm=0",
        "--force-store-cache=cg": "-ppu-fscm=2",
        "--force-store-cache=cv": "-ppu-fscm=3",
        "--force-store-cache=cs": "-ppu-fscm=4",
        "--force-store-cache=lu": "-ppu-fscm=5",
        "--force-store-cache=wb": "-ppu-fscm=0",
        "--force-store-cache=wt": "-ppu-fscm=3",
        "-fscm=ca": "-ppu-fscm=0",
        "-fscm=cg": "-ppu-fscm=2",
        "-fscm=cv": "-ppu-fscm=3",
        "-fscm=cs": "-ppu-fscm=4",
        "-fscm=lu": "-ppu-fscm=5",
        "-fscm=wb": "-ppu-fscm=0",
        "-fscm=wt": "-ppu-fscm=3",
        "--verbose": "--resource-usage",
        "-v": "--resource-usage",
        "-disable-optimizer-consts": {
          "needs_ignore": true
        },
        "--disable-optimizer-consts": {
          "needs_ignore": true
        }
      }
    }
  }
}
