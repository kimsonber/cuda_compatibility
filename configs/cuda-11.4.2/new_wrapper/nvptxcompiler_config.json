            "source_function": "nvPTXCompilerGetVersion",
            "target_function": "",
            "parameter_mapping": {},
            "custom_func_imp": "nvPTXCompileResult nvPTXCompilerGetVersion(unsigned int * major, unsigned int * minor) {\n // TraceCall(\"nvPTXCompilerGetVersion\");\n    if (major == nullptr || minor == nullptr) {\n      // NVPTXCOMPILE_ERROR_INTERNAL\n      return (nvPTXCompileResult)0x4;\n    }\n    *major = CUDA_VERSION / 1000;\n    *minor = (CUDA_VERSION - (*major * 1000)) / 10;\n    return NVPTXCOMPILE_SUCCESS;\n}\n\n"
        }
    ],
    "global_custom_code": {
        "loader_start": "\nstatic uint32_t g_profileDomain;\n\nstatic const char* g_profileFunctionList[] = {\n    \"nvPTXCompilerCompile\",\n    \"nvPTXCompilerCreate\",\n    \"nvPTXCompilerDestroy\",\n    \"nvPTXCompilerGetCompiledProgram\",\n    \"nvPTXCompilerGetCompiledProgramSize\",\n    \"nvPTXCompilerGetErrorLog\",\n    \"nvPTXCompilerGetErrorLogSize\",\n    \"nvPTXCompilerGetInfoLog\",\n    \"nvPTXCompilerGetInfoLogSize\",\n    \"nvPTXCompilerGetVersion\",\n};\n\nenum nvptxcompilerProfileCallbackId {\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerCompile = 0,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerCreate = 1,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerDestroy = 2,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerGetCompiledProgram = 3,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerGetCompiledProgramSize = 4,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerGetErrorLog = 5,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerGetErrorLogSize = 6,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerGetInfoLog = 7,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerGetInfoLogSize = 8,\n    nvptxcompiler_TRACE_CBID_nvPTXCompilerGetVersion = 9,\n};\n\ntypedef uint32_t (*nvptxcompilerRegisterProfileDomain)(const char* domain_name, const char** function_list, uint32_t function_number);\ntypedef uint8_t (*nvptxcompilerIsProfileCallbackEnabled)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvptxcompilerProfileCallbackBegin)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvptxcompilerProfileCallbackEnd)(uint32_t domain, uint32_t callback_id);\n\nstruct nvptxcompilerProfileHandler {\n    nvptxcompilerRegisterProfileDomain registerProfileDomain;\n    nvptxcompilerIsProfileCallbackEnabled isCallbackEnabled;\n    nvptxcompilerProfileCallbackBegin profileCallbackBegin;\n    nvptxcompilerProfileCallbackEnd profileCallbackEnd;\n};\n\nstatic nvptxcompilerProfileHandler g_profileHandler;\nstatic bool gDirectReturn = false;\nstatic const char* gLibName = \"nvptxcompiler\";\n\nstatic void InitializeProfileHandler() {\n    // get library patch\n    const char* profile_tool_library = getenv(\"WRAPPER_INJECTION_PATH\");\n    if (profile_tool_library == NULL) {\n        return;\n    }\n\n    // open profile library\n    void* tool_handler = dlopen(profile_tool_library, RTLD_LAZY);\n    if (!tool_handler) {\n        printf(\"cannot open the file:%s  with error %s\\n\", profile_tool_library, dlerror());\n        return;\n    }\n\n    // init profile handler\n    g_profileHandler.registerProfileDomain = reinterpret_cast<nvptxcompilerRegisterProfileDomain>(dlsym(tool_handler, \"wrapperRegisterProfileDomain\"));\n    g_profileHandler.isCallbackEnabled = reinterpret_cast<nvptxcompilerIsProfileCallbackEnabled>(dlsym(tool_handler, \"wrapperIsProfileCallbackEnabled\"));\n    g_profileHandler.profileCallbackBegin = reinterpret_cast<nvptxcompilerProfileCallbackBegin>(dlsym(tool_handler, \"wrapperProfileCallbackBegin\"));\n    g_profileHandler.profileCallbackEnd = reinterpret_cast<nvptxcompilerProfileCallbackEnd>(dlsym(tool_handler, \"wrapperProfileCallbackEnd\"));\n\n    // register profile domain\n    if (g_profileHandler.registerProfileDomain != NULL) {\n        g_profileDomain = g_profileHandler.registerProfileDomain(gLibName, g_profileFunctionList, sizeof(g_profileFunctionList) / sizeof(g_profileFunctionList[0]));\n        if (g_profileDomain == 0) {\n            g_profileHandler.isCallbackEnabled = NULL;\n        }\n    }\n}\n",
        "post_dlopen_tgt_lib": "\n    InitializeProfileHandler();\n",
        "pre_wrapper_call": "\n    bool needProfile = g_profileHandler.isCallbackEnabled != NULL &&\n        g_profileHandler.isCallbackEnabled(g_profileDomain, nvptxcompiler_TRACE_CBID_$WRAPPER_FUNC_NAME) != 0;\n    if (needProfile) {\n        g_profileHandler.profileCallbackBegin(g_profileDomain, nvptxcompiler_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n",
        "post_wrapper_call": "\n    if (needProfile) {\n        g_profileHandler.profileCallbackEnd(g_profileDomain, nvptxcompiler_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n"
    }
}
