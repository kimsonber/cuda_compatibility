    "global_custom_code": {
        "loader_start": "\nstatic uint32_t g_profileDomain;\n\nstatic const char* g_profileFunctionList[] = {\n    \"CuptiUtilGetBufferInfo\",\n    \"CuptiUtilGetHeaderData\",\n    \"CuptiUtilGetPcSampData\",\n    \"CuptiUtilMergePcSampData\",\n    \"CuptiUtilPutPcSampData\",\n};\n\nenum pcsamplingutilProfileCallbackId {\n    pcsamplingutil_TRACE_CBID_CuptiUtilGetBufferInfo = 0,\n    pcsamplingutil_TRACE_CBID_CuptiUtilGetHeaderData = 1,\n    pcsamplingutil_TRACE_CBID_CuptiUtilGetPcSampData = 2,\n    pcsamplingutil_TRACE_CBID_CuptiUtilMergePcSampData = 3,\n    pcsamplingutil_TRACE_CBID_CuptiUtilPutPcSampData = 4,\n};\n\ntypedef uint32_t (*pcsamplingutilRegisterProfileDomain)(const char* domain_name, const char** function_list, uint32_t function_number);\ntypedef uint8_t (*pcsamplingutilIsProfileCallbackEnabled)(uint32_t domain, uint32_t callback_id);\ntypedef void (*pcsamplingutilProfileCallbackBegin)(uint32_t domain, uint32_t callback_id);\ntypedef void (*pcsamplingutilProfileCallbackEnd)(uint32_t domain, uint32_t callback_id);\n\nstruct pcsamplingutilProfileHandler {\n    pcsamplingutilRegisterProfileDomain registerProfileDomain;\n    pcsamplingutilIsProfileCallbackEnabled isCallbackEnabled;\n    pcsamplingutilProfileCallbackBegin profileCallbackBegin;\n    pcsamplingutilProfileCallbackEnd profileCallbackEnd;\n};\n\nstatic pcsamplingutilProfileHandler g_profileHandler;\nstatic bool gDirectReturn = false;\nstatic const char* gLibName = \"pcsamplingutil\";\n\nstatic void InitializeProfileHandler() {\n    // get library patch\n    const char* profile_tool_library = getenv(\"WRAPPER_INJECTION_PATH\");\n    if (profile_tool_library == NULL) {\n        return;\n    }\n\n    // open profile library\n    void* tool_handler = dlopen(profile_tool_library, RTLD_LAZY);\n    if (!tool_handler) {\n        printf(\"cannot open the file:%s  with error %s\\n\", profile_tool_library, dlerror());\n        return;\n    }\n\n    // init profile handler\n    g_profileHandler.registerProfileDomain = reinterpret_cast<pcsamplingutilRegisterProfileDomain>(dlsym(tool_handler, \"wrapperRegisterProfileDomain\"));\n    g_profileHandler.isCallbackEnabled = reinterpret_cast<pcsamplingutilIsProfileCallbackEnabled>(dlsym(tool_handler, \"wrapperIsProfileCallbackEnabled\"));\n    g_profileHandler.profileCallbackBegin = reinterpret_cast<pcsamplingutilProfileCallbackBegin>(dlsym(tool_handler, \"wrapperProfileCallbackBegin\"));\n    g_profileHandler.profileCallbackEnd = reinterpret_cast<pcsamplingutilProfileCallbackEnd>(dlsym(tool_handler, \"wrapperProfileCallbackEnd\"));\n\n    // register profile domain\n    if (g_profileHandler.registerProfileDomain != NULL) {\n        g_profileDomain = g_profileHandler.registerProfileDomain(gLibName, g_profileFunctionList, sizeof(g_profileFunctionList) / sizeof(g_profileFunctionList[0]));\n        if (g_profileDomain == 0) {\n            g_profileHandler.isCallbackEnabled = NULL;\n        }\n    }\n}\n",
        "post_dlopen_tgt_lib": "\n    InitializeProfileHandler();\n",
        "pre_wrapper_call": "\n    bool needProfile = g_profileHandler.isCallbackEnabled != NULL &&\n        g_profileHandler.isCallbackEnabled(g_profileDomain, pcsamplingutil_TRACE_CBID_$WRAPPER_FUNC_NAME) != 0;\n    if (needProfile) {\n        g_profileHandler.profileCallbackBegin(g_profileDomain, pcsamplingutil_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n",
        "post_wrapper_call": "\n    if (needProfile) {\n        g_profileHandler.profileCallbackEnd(g_profileDomain, pcsamplingutil_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n"
    }
