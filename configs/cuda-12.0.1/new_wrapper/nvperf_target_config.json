    "global_custom_code": {
        "loader_start": "\nstatic uint32_t g_profileDomain;\n\nstatic const char* g_profileFunctionList[] = {\n    \"NVPW_Adapter_GetDeviceIndex\",\n    \"NVPW_Config_GetNumPasses\",\n    \"NVPW_Config_GetNumPasses_V2\",\n    \"NVPW_CounterData_GetChipName\",\n    \"NVPW_CounterData_GetNumRanges\",\n    \"NVPW_CounterData_GetRangeDescriptions\",\n    \"NVPW_Device_GetClockStatus\",\n    \"NVPW_Device_GetMigAttributes\",\n    \"NVPW_Device_GetNames\",\n    \"NVPW_Device_GetPciBusIds\",\n    \"NVPW_Device_SetClockSetting\",\n    \"NVPW_GetDeviceCount\",\n    \"NVPW_InitializeTarget\",\n    \"NVPW_PeriodicSampler_CounterData_GetInfo\",\n    \"NVPW_PeriodicSampler_CounterData_GetSampleTime\",\n    \"NVPW_PeriodicSampler_CounterData_GetTriggerCount\",\n    \"NVPW_PeriodicSampler_CounterData_TrimInPlace\",\n    \"NVPW_Profiler_CounterData_GetRangeDescriptions\",\n    \"NVPW_QueryVersionNumber\",\n};\n\nenum nvperf_targetProfileCallbackId {\n    nvperf_target_TRACE_CBID_NVPW_Adapter_GetDeviceIndex = 0,\n    nvperf_target_TRACE_CBID_NVPW_Config_GetNumPasses = 1,\n    nvperf_target_TRACE_CBID_NVPW_Config_GetNumPasses_V2 = 2,\n    nvperf_target_TRACE_CBID_NVPW_CounterData_GetChipName = 3,\n    nvperf_target_TRACE_CBID_NVPW_CounterData_GetNumRanges = 4,\n    nvperf_target_TRACE_CBID_NVPW_CounterData_GetRangeDescriptions = 5,\n    nvperf_target_TRACE_CBID_NVPW_Device_GetClockStatus = 6,\n    nvperf_target_TRACE_CBID_NVPW_Device_GetMigAttributes = 7,\n    nvperf_target_TRACE_CBID_NVPW_Device_GetNames = 8,\n    nvperf_target_TRACE_CBID_NVPW_Device_GetPciBusIds = 9,\n    nvperf_target_TRACE_CBID_NVPW_Device_SetClockSetting = 10,\n    nvperf_target_TRACE_CBID_NVPW_GetDeviceCount = 11,\n    nvperf_target_TRACE_CBID_NVPW_InitializeTarget = 12,\n    nvperf_target_TRACE_CBID_NVPW_PeriodicSampler_CounterData_GetInfo = 13,\n    nvperf_target_TRACE_CBID_NVPW_PeriodicSampler_CounterData_GetSampleTime = 14,\n    nvperf_target_TRACE_CBID_NVPW_PeriodicSampler_CounterData_GetTriggerCount = 15,\n    nvperf_target_TRACE_CBID_NVPW_PeriodicSampler_CounterData_TrimInPlace = 16,\n    nvperf_target_TRACE_CBID_NVPW_Profiler_CounterData_GetRangeDescriptions = 17,\n    nvperf_target_TRACE_CBID_NVPW_QueryVersionNumber = 18,\n};\n\ntypedef uint32_t (*nvperf_targetRegisterProfileDomain)(const char* domain_name, const char** function_list, uint32_t function_number);\ntypedef uint8_t (*nvperf_targetIsProfileCallbackEnabled)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvperf_targetProfileCallbackBegin)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvperf_targetProfileCallbackEnd)(uint32_t domain, uint32_t callback_id);\n\nstruct nvperf_targetProfileHandler {\n    nvperf_targetRegisterProfileDomain registerProfileDomain;\n    nvperf_targetIsProfileCallbackEnabled isCallbackEnabled;\n    nvperf_targetProfileCallbackBegin profileCallbackBegin;\n    nvperf_targetProfileCallbackEnd profileCallbackEnd;\n};\n\nstatic nvperf_targetProfileHandler g_profileHandler;\nstatic bool gDirectReturn = false;\nstatic const char* gLibName = \"nvperf_target\";\n\nstatic void InitializeProfileHandler() {\n    // get library patch\n    const char* profile_tool_library = getenv(\"WRAPPER_INJECTION_PATH\");\n    if (profile_tool_library == NULL) {\n        return;\n    }\n\n    // open profile library\n    void* tool_handler = dlopen(profile_tool_library, RTLD_LAZY);\n    if (!tool_handler) {\n        printf(\"cannot open the file:%s  with error %s\\n\", profile_tool_library, dlerror());\n        return;\n    }\n\n    // init profile handler\n    g_profileHandler.registerProfileDomain = reinterpret_cast<nvperf_targetRegisterProfileDomain>(dlsym(tool_handler, \"wrapperRegisterProfileDomain\"));\n    g_profileHandler.isCallbackEnabled = reinterpret_cast<nvperf_targetIsProfileCallbackEnabled>(dlsym(tool_handler, \"wrapperIsProfileCallbackEnabled\"));\n    g_profileHandler.profileCallbackBegin = reinterpret_cast<nvperf_targetProfileCallbackBegin>(dlsym(tool_handler, \"wrapperProfileCallbackBegin\"));\n    g_profileHandler.profileCallbackEnd = reinterpret_cast<nvperf_targetProfileCallbackEnd>(dlsym(tool_handler, \"wrapperProfileCallbackEnd\"));\n\n    // register profile domain\n    if (g_profileHandler.registerProfileDomain != NULL) {\n        g_profileDomain = g_profileHandler.registerProfileDomain(gLibName, g_profileFunctionList, sizeof(g_profileFunctionList) / sizeof(g_profileFunctionList[0]));\n        if (g_profileDomain == 0) {\n            g_profileHandler.isCallbackEnabled = NULL;\n        }\n    }\n}\n",
        "post_dlopen_tgt_lib": "\n    InitializeProfileHandler();\n",
        "pre_wrapper_call": "\n    bool needProfile = g_profileHandler.isCallbackEnabled != NULL &&\n        g_profileHandler.isCallbackEnabled(g_profileDomain, nvperf_target_TRACE_CBID_$WRAPPER_FUNC_NAME) != 0;\n    if (needProfile) {\n        g_profileHandler.profileCallbackBegin(g_profileDomain, nvperf_target_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n",
        "post_wrapper_call": "\n    if (needProfile) {\n        g_profileHandler.profileCallbackEnd(g_profileDomain, nvperf_target_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n"
    }
