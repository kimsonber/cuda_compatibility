    "global_custom_code": {
        "loader_start": "\nstatic uint32_t g_profileDomain;\n\nstatic const char* g_profileFunctionList[] = {\n    \"nppGetGpuDeviceProperties\",\n    \"nppGetGpuName\",\n    \"nppGetGpuNumSMs\",\n    \"nppGetLibVersion\",\n    \"nppGetMaxThreadsPerBlock\",\n    \"nppGetMaxThreadsPerSM\",\n    \"nppGetStream\",\n    \"nppGetStreamContext\",\n    \"nppGetStreamMaxThreadsPerSM\",\n    \"nppGetStreamNumSMs\",\n    \"nppSetStream\",\n};\n\nenum nppcProfileCallbackId {\n    nppc_TRACE_CBID_nppGetGpuDeviceProperties = 0,\n    nppc_TRACE_CBID_nppGetGpuName = 1,\n    nppc_TRACE_CBID_nppGetGpuNumSMs = 2,\n    nppc_TRACE_CBID_nppGetLibVersion = 3,\n    nppc_TRACE_CBID_nppGetMaxThreadsPerBlock = 4,\n    nppc_TRACE_CBID_nppGetMaxThreadsPerSM = 5,\n    nppc_TRACE_CBID_nppGetStream = 6,\n    nppc_TRACE_CBID_nppGetStreamContext = 7,\n    nppc_TRACE_CBID_nppGetStreamMaxThreadsPerSM = 8,\n    nppc_TRACE_CBID_nppGetStreamNumSMs = 9,\n    nppc_TRACE_CBID_nppSetStream = 10,\n};\n\ntypedef uint32_t (*nppcRegisterProfileDomain)(const char* domain_name, const char** function_list, uint32_t function_number);\ntypedef uint8_t (*nppcIsProfileCallbackEnabled)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nppcProfileCallbackBegin)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nppcProfileCallbackEnd)(uint32_t domain, uint32_t callback_id);\n\nstruct nppcProfileHandler {\n    nppcRegisterProfileDomain registerProfileDomain;\n    nppcIsProfileCallbackEnabled isCallbackEnabled;\n    nppcProfileCallbackBegin profileCallbackBegin;\n    nppcProfileCallbackEnd profileCallbackEnd;\n};\n\nstatic nppcProfileHandler g_profileHandler;\nstatic bool gDirectReturn = false;\nstatic const char* gLibName = \"nppc\";\n\nstatic void InitializeProfileHandler() {\n    // get library patch\n    const char* profile_tool_library = getenv(\"WRAPPER_INJECTION_PATH\");\n    if (profile_tool_library == NULL) {\n        return;\n    }\n\n    // open profile library\n    void* tool_handler = dlopen(profile_tool_library, RTLD_LAZY);\n    if (!tool_handler) {\n        printf(\"cannot open the file:%s  with error %s\\n\", profile_tool_library, dlerror());\n        return;\n    }\n\n    // init profile handler\n    g_profileHandler.registerProfileDomain = reinterpret_cast<nppcRegisterProfileDomain>(dlsym(tool_handler, \"wrapperRegisterProfileDomain\"));\n    g_profileHandler.isCallbackEnabled = reinterpret_cast<nppcIsProfileCallbackEnabled>(dlsym(tool_handler, \"wrapperIsProfileCallbackEnabled\"));\n    g_profileHandler.profileCallbackBegin = reinterpret_cast<nppcProfileCallbackBegin>(dlsym(tool_handler, \"wrapperProfileCallbackBegin\"));\n    g_profileHandler.profileCallbackEnd = reinterpret_cast<nppcProfileCallbackEnd>(dlsym(tool_handler, \"wrapperProfileCallbackEnd\"));\n\n    // register profile domain\n    if (g_profileHandler.registerProfileDomain != NULL) {\n        g_profileDomain = g_profileHandler.registerProfileDomain(gLibName, g_profileFunctionList, sizeof(g_profileFunctionList) / sizeof(g_profileFunctionList[0]));\n        if (g_profileDomain == 0) {\n            g_profileHandler.isCallbackEnabled = NULL;\n        }\n    }\n}\n",
        "post_dlopen_tgt_lib": "\n    InitializeProfileHandler();\n",
        "pre_wrapper_call": "\n    bool needProfile = g_profileHandler.isCallbackEnabled != NULL &&\n        g_profileHandler.isCallbackEnabled(g_profileDomain, nppc_TRACE_CBID_$WRAPPER_FUNC_NAME) != 0;\n    if (needProfile) {\n        g_profileHandler.profileCallbackBegin(g_profileDomain, nppc_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n",
        "post_wrapper_call": "\n    if (needProfile) {\n        g_profileHandler.profileCallbackEnd(g_profileDomain, nppc_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n"
    }
