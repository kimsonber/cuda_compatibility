        {
            "source_function": "nvFatbinVersion",
            "target_function": "",
            "parameter_mapping": {},
            "custom_func_imp": "nvFatbinResult nvFatbinVersion(unsigned int * major, unsigned int * minor) {\n // TraceCall(\"nvFatbinVersion\");\n    if (major == nullptr || minor == nullptr) {\n      return NVFATBIN_ERROR_NULL_POINTER;\n    }\n    *major = CUDA_VERSION / 1000;\n    *minor = (CUDA_VERSION - (*major * 1000)) / 10;\n    return NVFATBIN_SUCCESS;\n}\n\n"
        }
    ],
    "global_custom_code": {
        "loader_start": "\nstatic uint32_t g_profileDomain;\n\nstatic const char* g_profileFunctionList[] = {\n    \"nvFatbinAddCubin\",\n    \"nvFatbinAddLTOIR\",\n    \"nvFatbinAddPTX\",\n    \"nvFatbinCreate\",\n    \"nvFatbinDestroy\",\n    \"nvFatbinGet\",\n    \"nvFatbinGetErrorString\",\n    \"nvFatbinSize\",\n    \"nvFatbinVersion\",\n};\n\nenum nvfatbinProfileCallbackId {\n    nvfatbin_TRACE_CBID_nvFatbinAddCubin = 0,\n    nvfatbin_TRACE_CBID_nvFatbinAddLTOIR = 1,\n    nvfatbin_TRACE_CBID_nvFatbinAddPTX = 2,\n    nvfatbin_TRACE_CBID_nvFatbinCreate = 3,\n    nvfatbin_TRACE_CBID_nvFatbinDestroy = 4,\n    nvfatbin_TRACE_CBID_nvFatbinGet = 5,\n    nvfatbin_TRACE_CBID_nvFatbinGetErrorString = 6,\n    nvfatbin_TRACE_CBID_nvFatbinSize = 7,\n    nvfatbin_TRACE_CBID_nvFatbinVersion = 8,\n};\n\ntypedef uint32_t (*nvfatbinRegisterProfileDomain)(const char* domain_name, const char** function_list, uint32_t function_number);\ntypedef uint8_t (*nvfatbinIsProfileCallbackEnabled)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvfatbinProfileCallbackBegin)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvfatbinProfileCallbackEnd)(uint32_t domain, uint32_t callback_id);\n\nstruct nvfatbinProfileHandler {\n    nvfatbinRegisterProfileDomain registerProfileDomain;\n    nvfatbinIsProfileCallbackEnabled isCallbackEnabled;\n    nvfatbinProfileCallbackBegin profileCallbackBegin;\n    nvfatbinProfileCallbackEnd profileCallbackEnd;\n};\n\nstatic nvfatbinProfileHandler g_profileHandler;\nstatic bool gDirectReturn = false;\nstatic const char* gLibName = \"nvfatbin\";\n\nstatic void InitializeProfileHandler() {\n    // get library patch\n    const char* profile_tool_library = getenv(\"WRAPPER_INJECTION_PATH\");\n    if (profile_tool_library == NULL) {\n        return;\n    }\n\n    // open profile library\n    void* tool_handler = dlopen(profile_tool_library, RTLD_LAZY);\n    if (!tool_handler) {\n        printf(\"cannot open the file:%s  with error %s\\n\", profile_tool_library, dlerror());\n        return;\n    }\n\n    // init profile handler\n    g_profileHandler.registerProfileDomain = reinterpret_cast<nvfatbinRegisterProfileDomain>(dlsym(tool_handler, \"wrapperRegisterProfileDomain\"));\n    g_profileHandler.isCallbackEnabled = reinterpret_cast<nvfatbinIsProfileCallbackEnabled>(dlsym(tool_handler, \"wrapperIsProfileCallbackEnabled\"));\n    g_profileHandler.profileCallbackBegin = reinterpret_cast<nvfatbinProfileCallbackBegin>(dlsym(tool_handler, \"wrapperProfileCallbackBegin\"));\n    g_profileHandler.profileCallbackEnd = reinterpret_cast<nvfatbinProfileCallbackEnd>(dlsym(tool_handler, \"wrapperProfileCallbackEnd\"));\n\n    // register profile domain\n    if (g_profileHandler.registerProfileDomain != NULL) {\n        g_profileDomain = g_profileHandler.registerProfileDomain(gLibName, g_profileFunctionList, sizeof(g_profileFunctionList) / sizeof(g_profileFunctionList[0]));\n        if (g_profileDomain == 0) {\n            g_profileHandler.isCallbackEnabled = NULL;\n        }\n    }\n}\n",
        "post_dlopen_tgt_lib": "\n    InitializeProfileHandler();\n",
        "pre_wrapper_call": "\n    bool needProfile = g_profileHandler.isCallbackEnabled != NULL &&\n        g_profileHandler.isCallbackEnabled(g_profileDomain, nvfatbin_TRACE_CBID_$WRAPPER_FUNC_NAME) != 0;\n    if (needProfile) {\n        g_profileHandler.profileCallbackBegin(g_profileDomain, nvfatbin_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n",
        "post_wrapper_call": "\n    if (needProfile) {\n        g_profileHandler.profileCallbackEnd(g_profileDomain, nvfatbin_TRACE_CBID_$WRAPPER_FUNC_NAME);\n    }\n"
    }
}
