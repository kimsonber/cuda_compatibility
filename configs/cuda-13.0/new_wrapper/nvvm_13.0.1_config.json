    "global_custom_code": {
        "loader_start": "\nstatic uint32_t g_profileDomain;\n\nstatic const char* g_profileFunctionList[] = {\n    \"nvvmAddModuleToProgram\",\n    \"nvvmCompileProgram\",\n    \"nvvmCreateProgram\",\n    \"nvvmDestroyProgram\",\n    \"nvvmGetCompiledResult\",\n    \"nvvmGetCompiledResultSize\",\n    \"nvvmGetErrorString\",\n    \"nvvmGetProgramLog\",\n    \"nvvmGetProgramLogSize\",\n    \"nvvmIRVersion\",\n    \"nvvmLazyAddModuleToProgram\",\n    \"nvvmVerifyProgram\",\n    \"nvvmVersion\",\n};\n\nenum nvvmProfileCallbackId {\n    nvvm_TRACE_CBID_nvvmAddModuleToProgram = 0,\n    nvvm_TRACE_CBID_nvvmCompileProgram = 1,\n    nvvm_TRACE_CBID_nvvmCreateProgram = 2,\n    nvvm_TRACE_CBID_nvvmDestroyProgram = 3,\n    nvvm_TRACE_CBID_nvvmGetCompiledResult = 4,\n    nvvm_TRACE_CBID_nvvmGetCompiledResultSize = 5,\n    nvvm_TRACE_CBID_nvvmGetErrorString = 6,\n    nvvm_TRACE_CBID_nvvmGetProgramLog = 7,\n    nvvm_TRACE_CBID_nvvmGetProgramLogSize = 8,\n    nvvm_TRACE_CBID_nvvmIRVersion = 9,\n    nvvm_TRACE_CBID_nvvmLazyAddModuleToProgram = 10,\n    nvvm_TRACE_CBID_nvvmVerifyProgram = 11,\n    nvvm_TRACE_CBID_nvvmVersion = 12,\n};\n\ntypedef uint32_t (*nvvmRegisterProfileDomain)(const char* domain_name, const char** function_list, uint32_t function_number);\ntypedef uint8_t (*nvvmIsProfileCallbackEnabled)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvvmProfileCallbackBegin)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvvmProfileCallbackEnd)(uint32_t domain, uint32_t callback_id);\n\nstruct nvvmProfileHandler {\n    nvvmRegisterProfileDomain registerProfileDomain;\n    nvvmIsProfileCallbackEnabled isCallbackEnabled;\n    nvvmProfileCallbackBegin profileCallbackBegin;\n    nvvmProfileCallbackEnd profileCallbackEnd;\n};\n\nstatic nvvmProfileHandler g_profileHandler;\nstatic bool gDirectReturn = false;\nstatic const char* gLibName = \"nvvm\";\n\nstatic void InitializeProfileHandler() {\n    // get library patch\n    const char* profile_tool_library = getenv(\"WRAPPER_INJECTION_PATH\");\n    if (profile_tool_library == NULL) {\n        return;\n    }\n\n    // open profile library\n    void* tool_handler = dlopen(profile_tool_library, RTLD_LAZY);\n    if (!tool_handler) {\n        printf(\"cannot open the file:%s  with error %s\\n\", profile_tool_library, dlerror());\n        return;\n    }\n\n    // init profile handler\n    g_profileHandler.registerProfileDomain = reinterpret_cast<nvvmRegisterProfileDomain>(dlsym(tool_handler, \"wrapperRegisterProfileDomain\"));\n    g_profileHandler.isCallbackEnabled = reinterpret_cast<nvvmIsProfileCallbackEnabled>(dlsym(tool_handler, \"wrapperIsProfileCallbackEnabled\"));\n    g_profileHandler.profileCallbackBegin = reinterpret_cast<nvvmProfileCallbackBegin>(dlsym(tool_handler, \"wrapperProfileCallbackBegin\"));\n    g_profileHandler.profileCallbackEnd = reinterpret_cast<nvvmProfileCallbackEnd>(dlsym(tool_handler, \"wrapperProfileCallbackEnd\"));\n\n    // register profile domain\n    if (g_profileHandler.registerProfileDomain != NULL) {\n        g_profileDomain = g_profileHandler.registerProfileDomain(gLibName, g_profileFunctionList, sizeof(g_profileFunctionList) / sizeof(g_profileFunctionList[0]));\n        if (g_profileDomain == 0) {\n            g_profileHandler.isCallbackEnabled = NULL;\n        }\n    }\n}\n",
