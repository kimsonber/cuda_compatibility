    "global_custom_code": {
        "loader_start": "\nstatic uint32_t g_profileDomain;\n\nstatic const char* g_profileFunctionList[] = {\n    \"__nvJitLinkAddData_13_1\",\n    \"__nvJitLinkAddFile_13_1\",\n    \"__nvJitLinkComplete_13_1\",\n    \"__nvJitLinkCreate_13_1\",\n    \"__nvJitLinkDestroy_13_1\",\n    \"__nvJitLinkGetErrorLogSize_13_1\",\n    \"__nvJitLinkGetErrorLog_13_1\",\n    \"__nvJitLinkGetInfoLogSize_13_1\",\n    \"__nvJitLinkGetInfoLog_13_1\",\n    \"__nvJitLinkGetLinkedCubinSize_13_1\",\n    \"__nvJitLinkGetLinkedCubin_13_1\",\n    \"__nvJitLinkGetLinkedPtxSize_13_1\",\n    \"__nvJitLinkGetLinkedPtx_13_1\",\n    \"nvJitLinkVersion\",\n};\n\nenum nvJitLinkProfileCallbackId {\n    nvJitLink_TRACE_CBID___nvJitLinkAddData_13_1 = 0,\n    nvJitLink_TRACE_CBID___nvJitLinkAddFile_13_1 = 1,\n    nvJitLink_TRACE_CBID___nvJitLinkComplete_13_1 = 2,\n    nvJitLink_TRACE_CBID___nvJitLinkCreate_13_1 = 3,\n    nvJitLink_TRACE_CBID___nvJitLinkDestroy_13_1 = 4,\n    nvJitLink_TRACE_CBID___nvJitLinkGetErrorLogSize_13_1 = 5,\n    nvJitLink_TRACE_CBID___nvJitLinkGetErrorLog_13_1 = 6,\n    nvJitLink_TRACE_CBID___nvJitLinkGetInfoLogSize_13_1 = 7,\n    nvJitLink_TRACE_CBID___nvJitLinkGetInfoLog_13_1 = 8,\n    nvJitLink_TRACE_CBID___nvJitLinkGetLinkedCubinSize_13_1 = 9,\n    nvJitLink_TRACE_CBID___nvJitLinkGetLinkedCubin_13_1 = 10,\n    nvJitLink_TRACE_CBID___nvJitLinkGetLinkedPtxSize_13_1 = 11,\n    nvJitLink_TRACE_CBID___nvJitLinkGetLinkedPtx_13_1 = 12,\n    nvJitLink_TRACE_CBID_nvJitLinkVersion = 13,\n};\n\ntypedef uint32_t (*nvJitLinkRegisterProfileDomain)(const char* domain_name, const char** function_list, uint32_t function_number);\ntypedef uint8_t (*nvJitLinkIsProfileCallbackEnabled)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvJitLinkProfileCallbackBegin)(uint32_t domain, uint32_t callback_id);\ntypedef void (*nvJitLinkProfileCallbackEnd)(uint32_t domain, uint32_t callback_id);\n\nstruct nvJitLinkProfileHandler {\n    nvJitLinkRegisterProfileDomain registerProfileDomain;\n    nvJitLinkIsProfileCallbackEnabled isCallbackEnabled;\n    nvJitLinkProfileCallbackBegin profileCallbackBegin;\n    nvJitLinkProfileCallbackEnd profileCallbackEnd;\n};\n\nstatic nvJitLinkProfileHandler g_profileHandler;\nstatic bool gDirectReturn = false;\nstatic const char* gLibName = \"nvJitLink\";\n\nstatic void InitializeProfileHandler() {\n    // get library patch\n    const char* profile_tool_library = getenv(\"WRAPPER_INJECTION_PATH\");\n    if (profile_tool_library == NULL) {\n        return;\n    }\n\n    // open profile library\n    void* tool_handler = dlopen(profile_tool_library, RTLD_LAZY);\n    if (!tool_handler) {\n        printf(\"cannot open the file:%s  with error %s\\n\", profile_tool_library, dlerror());\n        return;\n    }\n\n    // init profile handler\n    g_profileHandler.registerProfileDomain = reinterpret_cast<nvJitLinkRegisterProfileDomain>(dlsym(tool_handler, \"wrapperRegisterProfileDomain\"));\n    g_profileHandler.isCallbackEnabled = reinterpret_cast<nvJitLinkIsProfileCallbackEnabled>(dlsym(tool_handler, \"wrapperIsProfileCallbackEnabled\"));\n    g_profileHandler.profileCallbackBegin = reinterpret_cast<nvJitLinkProfileCallbackBegin>(dlsym(tool_handler, \"wrapperProfileCallbackBegin\"));\n    g_profileHandler.profileCallbackEnd = reinterpret_cast<nvJitLinkProfileCallbackEnd>(dlsym(tool_handler, \"wrapperProfileCallbackEnd\"));\n\n    // register profile domain\n    if (g_profileHandler.registerProfileDomain != NULL) {\n        g_profileDomain = g_profileHandler.registerProfileDomain(gLibName, g_profileFunctionList, sizeof(g_profileFunctionList) / sizeof(g_profileFunctionList[0]));\n        if (g_profileDomain == 0) {\n            g_profileHandler.isCallbackEnabled = NULL;\n        }\n    }\n}\n",
